PATCHPILOT_ENV=development
PATCHPILOT_PLANNER=deterministic
PATCHPILOT_DATABASE_PATH=.patchpilot/patchpilot.db
# Production PostgreSQL connection string. Leave empty for local SQLite.
DATABASE_URL=
PATCHPILOT_WORKSPACE_ROOT=.patchpilot/workspaces
PATCHPILOT_MAX_CHANGED_FILES=5
PATCHPILOT_MAX_PATCH_BYTES=30000
PATCHPILOT_COMMAND_TIMEOUT_SECONDS=120
PATCHPILOT_SESSION_COOKIE=patchpilot_session
PATCHPILOT_SESSION_DAYS=14
PATCHPILOT_ALLOWED_COMMANDS=python,python3,pytest,ruff,mypy,git,rg
PATCHPILOT_PROTECTED_PATHS=.git,.github/workflows,.env,secrets,infra,terraform

# Optional real model planner
OPENAI_API_KEY=
OPENAI_MODEL=

# GitHub App integration. Keep real values only in .env or the hosting
# provider's secret manager. For a PEM key in .env, encode line breaks as \n.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
