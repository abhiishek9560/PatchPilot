FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATCHPILOT_DATABASE_PATH=/tmp/patchpilot.db \
    PATCHPILOT_WORKSPACE_ROOT=/tmp/workspaces

RUN apt-get update \
    && apt-get install --no-install-recommends -y git \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 10001 patchpilot
RUN mkdir -p /data /workspaces \
    && chown -R patchpilot:patchpilot /data /workspaces
WORKDIR /app
COPY pyproject.toml README.md ./
COPY apps/api ./apps/api
COPY dist ./dist
COPY fixtures ./fixtures
RUN pip install --no-cache-dir .

USER patchpilot
EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn patchpilot.main:app --app-dir apps/api --host 0.0.0.0 --port ${PORT:-8000}"]
